PROJECT_ROOT=


MINERU_API_TOKEN=your-mineru-token
MINERU_BASE_URL=https://mineru.net/api/v4

#minio配置
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=enterprise-rag
MINIO_IMG_DIR=/kb-images
MINIO_SECURE=False


#llm配置 (走 DeepSeek 的 OpenAI 兼容端点)
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=sk-your-deepseek-key
LLM_DEFAULT_MODEL=deepseek-v4-flash
LLM_DEFAULT_TEMPERATURE=0.1
LLM_DEFAULT_PROVIDER=openai
LLM_VL_MODEL=deepseek-v4-flash-vision-exp # 视觉模型(node_md_img 节点图片摘要用), DeepSeek 端点上的实验版视觉模型, 与文本模型走同一个 base_url
